# Copy to .env and adjust. NEVER commit .env (spec section 13).

MODE_DEFAULT=paper

# Leave unset for in-memory event store (dev). For Postgres:
# DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading

STARTING_CASH=100000

# Conviction (spec section 16)
TRADE_THRESHOLD=70
WATCH_THRESHOLD=40
CORROBORATION_WINDOW_DAYS=21

# Risk caps — REQUIRED, the app refuses to start without them (FR-RISK-2)
MAX_TRADE_PCT_OF_SLEEVE=10
MAX_POSITION_CONCENTRATION_PCT=25
MAX_DRAWDOWN_PCT=20

# Data integrity (anti-placeholder). When true, the platform refuses to let SYNTHETIC / fake /
# placeholder / seeded data reach a real decision: synthetic signals are dropped at ingestion,
# a real-broker evaluation aborts on any non-REAL signal, the app refuses to boot a real sleeve
# without real market data, and a sleeve cannot go live with synthetic data in its window. This
# turns ON AUTOMATICALLY whenever a real Alpaca account is wired (ENABLE_ALPACA_PAPER or
# ALLOW_LIVE) — so you can never trade a real account on fakes. Set it true to enforce the same
# on the in-process simulator. Leave false for a bare dev run (default).
REQUIRE_REAL_DATA=false

# Data sources (FR-ING). All external sources default OFF — a bare run makes no network
# calls. Enable the political pipeline by configuring these.
# NEWS_FEED_URLS is JSON: a list of RSS feed URLs. A signal is emitted only when an item names
# BOTH a REAL member of Congress (needs ENABLE_CONGRESS_ROSTER=true) AND a company in the
# directory AND hits a sentiment word — a low-yield CORROBORATION signal, not a firehose. Use
# Google News *search* feeds with the `when:14d` recency operator so items fall inside the
# corroboration window (a plain search returns mostly-stale articles that get filtered out).
# Recommended starter set (URL-encode the query; these are pre-encoded examples):
# NEWS_FEED_URLS=["https://news.google.com/rss/search?q=senator+OR+representative+OR+congress+(Boeing+OR+Lockheed+OR+Nvidia+OR+Microsoft+OR+Apple+OR+Pfizer+OR+Tesla+OR+Amazon)+when:14d&hl=en-US&gl=US&ceid=US:en","https://news.google.com/rss/search?q=senator+OR+congress+antitrust+OR+probe+OR+subpoena+OR+contract+OR+hearing+when:14d&hl=en-US&gl=US&ceid=US:en"]
NEWS_FEED_URLS=[]
# Real congressional roster (FR-POL-3). true => fetch the FREE unitedstates/congress-legislators
# dataset at startup so news / disclosed-trade signals attach to REAL members (Provenance.REAL)
# and can pass the anti-placeholder guard. Off => the synthetic seed roster (SYNTHETIC, blocked).
# Only fetched when a politician-using source (news or disclosed trades) is enabled.
ENABLE_CONGRESS_ROSTER=false
# USASpending federal contracts — FREE, no key, REAL signals, historical. true => the real
# strongest free signal flows (verified: real contractor awards -> REAL CONTRACT signals).
USASPENDING_ENABLED=false
USASPENDING_LOOKBACK_DAYS=30
# Optional disclosed-trade leg (lagged, corroboration only). Needs an endpoint + key.
DISCLOSED_TRADE_LEG_ENABLED=false
# CONGRESS_TRADES_ENDPOINT=https://financialmodelingprep.com/api/v4/senate-trading-rss-feed
# FMP_API_KEY=
HTTP_TIMEOUT_SECONDS=10

RECONCILE_INTERVAL_SECONDS=300
# 0 disables the scheduled political cycle; set > 0 (seconds) to poll sources automatically.
INGEST_INTERVAL_SECONDS=0
# Order sync (FR-REC/FR-EXE): pulls the broker's order state and records the lifecycle events
# the local log is missing — closes the loop for the Alpaca venue, which fills asynchronously
# after submission. 0 disables the scheduled job (the default); set > 0 (seconds) to run it on
# an interval. Harmless with the in-process PaperBroker (synchronous fills already recorded).
ORDER_SYNC_INTERVAL_SECONDS=0
LOG_LEVEL=INFO

# Live market data (live stock tracking + live P&L). OFF by construction — a bare run makes
# no network calls and /quotes returns {"enabled": false, ...}. Set ENABLE_LIVE_QUOTES=true
# AND provide data credentials to turn the feed on. Alpaca's data API accepts paper OR live
# keys; by default the feed reuses ALPACA_LIVE_* below if present, or set the dedicated data
# keys here (env-only, NEVER commit real keys). `last` is the bid/ask midpoint (no extra
# trade call). DEFAULT_WATCHLIST backs /quotes/tracked when no positions are held yet.
ENABLE_LIVE_QUOTES=false
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# Real-time quote stream behind /ws/quotes. Gated by the SAME ENABLE_LIVE_QUOTES + data-cred
# switch as the REST feed — no separate flag. Dormant by default (no socket). Override only to
# point at a different Alpaca data feed (e.g. the SIP feed instead of IEX).
ALPACA_DATA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
# ALPACA_DATA_KEY_ID=
# ALPACA_DATA_SECRET_KEY=
DEFAULT_WATCHLIST=["AAPL","MSFT","NVDA","TSLA","AMZN","GOOGL"]

# Real historical bars for backtests (FR-BT). OFF by construction — a bare run and the test
# suite price backtests off the deterministic synthetic path and make ZERO network calls. Set
# ENABLE_HISTORICAL_DATA=true (and provide data credentials above) to fetch REAL daily OHLC
# bars (bar close per day) from the Alpaca data API instead. Reuses the same ALPACA_DATA_*
# creds + base URL as the live quote feed. BACKTEST_LOOKBACK_DAYS bounds the bar date range
# when the recorded signals don't already span one.
ENABLE_HISTORICAL_DATA=false
BACKTEST_LOOKBACK_DAYS=180

# Alpaca PAPER trading venue (FR-EXE/FR-REC). A REAL paper account — NOT real money. When true
# (and paper or data credentials resolve), the ALPACA_PAPER_SLEEVE_ID sleeve executes on your
# Alpaca paper account instead of the in-process simulator, so reconciliation diffs local state
# against an authoritative external broker. Reuses ALPACA_DATA_* keys if the dedicated paper
# keys below are unset. One Alpaca account = one book, so exactly ONE sleeve routes here.
# Note: off-hours, Alpaca queues market orders until the next session (no instant fill).
ENABLE_ALPACA_PAPER=false
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_PAPER_KEY_ID=
# ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_SLEEVE_ID=sleeve-political

# Live trading (M5). REAL MONEY. Off by construction — leave ALLOW_LIVE=false unless you
# have read §11 of DESIGN.md and intend to trade live. Live credentials are SEPARATE from
# any paper credentials and must be least-privilege. NEVER commit real keys; .env is
# git-ignored. A sleeve still cannot go live until it passes the readiness preflight, and
# the risk caps above must be at or under the LIVE_MAX_* ceilings below.
ALLOW_LIVE=false
# ALPACA_LIVE_KEY_ID=
# ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
LIVE_MAX_TRADE_PCT_OF_SLEEVE=5
LIVE_MAX_POSITION_CONCENTRATION_PCT=15
LIVE_MAX_DRAWDOWN_PCT=10

# --- Auth (hardening) --------------------------------------------------------------------
# API key guarding the MUTATING/sensitive endpoints (POST /signals, /ingest, /backtest,
# /orders/sync, /orders/{id}/cancel, /reconcile, /kill-switch, /sleeves/{id}/mode and
# /sleeves/{id}/readiness). UNSET => those endpoints are OPEN (dev default; the app logs one
# startup warning). SET => present it as `Authorization: Bearer <key>` OR `X-API-Key: <key>`;
# a mismatch is 401. GET read endpoints stay open. NEVER commit a real key (.env is gitignored).
# API_KEY=

# --- Observability (hardening) -----------------------------------------------------------
# Structured JSON access logs (with a propagated X-Request-ID), Prometheus-text /metrics, and
# /healthz (liveness) + /readyz (readiness, which probes the DB when DATABASE_URL is set) are
# always on. ENABLE_METRICS=false hides the /metrics route (returns 404) if an operator wants
# metrics scraped only on a separate network.
ENABLE_METRICS=true

# --- Real-time trade-updates stream (hardening) ------------------------------------------
# Alpaca PAPER trade-updates WebSocket (account stream): records fills/status changes as events
# in REAL TIME, complementing the polling ORDER_SYNC (which stays as the reconciliation
# fallback). OFF by construction — only dialed when ENABLE_TRADE_UPDATES_STREAM=true AND the
# Alpaca paper venue is enabled with resolvable creds. A bare run opens no socket. The URL is
# derived from ALPACA_PAPER_BASE_URL (https -> wss + /stream) unless overridden below.
ENABLE_TRADE_UPDATES_STREAM=false
# ALPACA_TRADE_UPDATES_STREAM_URL=wss://paper-api.alpaca.markets/stream
